FROM node:20-alpine AS builder

WORKDIR /app/frontend

# Copy frontend package manifests from repository root context
COPY frontend/package*.json ./
RUN npm ci

# Copy frontend source code
COPY frontend/ ./

ARG VITE_API_URL=/api
ENV VITE_API_URL=/api

RUN npm run build

# Nginx production static server
FROM nginx:alpine

# Default environment configuration for Railway
ENV PORT=8080
ENV NGINX_ENVSUBST_FILTER="PORT"

COPY --from=builder /app/frontend/dist /usr/share/nginx/html

# Use official nginx template mechanism to dynamically substitute ${PORT} at container start
COPY frontend/nginx.conf /etc/nginx/templates/default.conf.template

EXPOSE 8080
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
